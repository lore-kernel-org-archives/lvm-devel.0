+++ b/tools/lvcreate.c
@@ -819,9 +819,9 @@ static int _lvcreate_params(struct lvcreate_params *lp,
 	    !_read_raid_params(lp, cmd))
 		return_0;
 
-	if (lp->create_thin_pool) {

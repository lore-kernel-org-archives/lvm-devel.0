-struct key_list {
-	struct key_list *next;
-	char key[1];
-};
-
-static struct key_list *_create_word(int n)
-{
-	struct key_list *kl = dbg_malloc(sizeof(*kl) + 32);
-	snprintf(kl->key, 32, "abc%ddef%d", n, n);
-	kl->next = 0;

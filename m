-                printf("first branch worked (as expected)\n");
-
-        dm_pool_free(p, blocks[5]);
-
-        if (blocks[COUNT - 1][0] == 'E')
-                printf("second branch worked (valgrind should have flagged this as an error)\n");
-
-        dm_pool_destroy(p);

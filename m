-
-/* Checks that freed chunks are marked NOACCESS */
-static void check_free2()
-{
-	struct dm_pool *p = dm_pool_create("", 900); /* 900 will get
-						      * rounded up to 1024,
-						      * 1024 would have got
-						      * rounded up to
-						      * 2048 */
-	char *data1, *data2;

@@ -710,16 +710,21 @@ static int _dm_task_run_v1(struct dm_tas
 			goto bad;
 	} 
 #ifdef DM_IOCTLS
-	else if (ioctl(_control_fd, command, dmi) < 0) {
-		if (_log_suppress)
-			log_verbose("device-mapper: %s ioctl failed: %s", 

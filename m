 conf/Makefile.in                          |    6 ++--
 conf/command_profile_template.profile.in  |   46 +++++++++++++++++++++++++
 conf/default.profile.in                   |   53 -----------------------------
 conf/metadata_profile_template.profile.in |   24 +++++++++++++
 configure                                 |    5 ++-
 configure.in                              |    3 +-
 spec/packages.inc                         |    3 +-
 8 files changed, 81 insertions(+), 60 deletions(-)


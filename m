 tools/cmds.h                |  143 +++++++
 tools/command-count.h       |   16 +
 tools/command-lines-input.h |  965 +++++++++++++++++++++++++++++++++++++++++++
 tools/dmsetup.c             |   14 +-
 4 files changed, 1132 insertions(+), 6 deletions(-)

